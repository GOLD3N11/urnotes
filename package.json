{
  "name": "urnotes-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "urNotes backend: one service, split into modules (accounts, school data, notifications).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate-cli.ts",
    "extract-school-data": "node scripts/extract-school-data.mjs",
    "vapid": "node scripts/vapid.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
