# Pune acest fișier ca backend/.env (sau copiază liniile) ca să testezi cu Postman, local.
AUTH_MODE=dev
FIREBASE_PROJECT_ID=local-test
ADMIN_EMAILS=admin@test.ro
CORS_ORIGINS=http://localhost:8000
# Pentru cererea „Cheia publică pentru push”: rulează `npm run vapid` și lipește cheile aici
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
