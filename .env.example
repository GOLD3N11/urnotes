# Copiază ca .env și completează. Nimic de aici nu se pune în git.
PORT=8080
DATABASE_URL=postgres://urnotes:urnotes@localhost:5432/urnotes

# Autentificarea: „firebase” (implicit) verifică jetoanele contului urNotes din Firebase.
# „dev” acceptă jetoane de test „dev:<uid>:<email>” — doar local, niciodată în producție.
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=zece-2f182

# Cine poate schimba datele școlare (anii, județele, examenele). Emailuri separate prin virgulă.
ADMIN_EMAILS=

# De unde are voie aplicația să cheme serverul.
CORS_ORIGINS=https://gold3n11.github.io,http://localhost:8000

# Notificările push (amintirea de seară). Generează-le cu: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@exemplu.ro
